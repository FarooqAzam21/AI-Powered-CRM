APP_NAME="AI Email Automation CRM"
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite:///./data/app.db
# Production (Docker): postgresql+psycopg2://crm:crm@db:5432/aicrm
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

JWT_SECRET_KEY=replace-with-long-random-secret
TOKEN_ENCRYPTION_KEY=

# ==================== GOOGLE OAUTH (required for sign-up / Gmail) ====================
# Create credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI must match exactly:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback

# ==================== PHASE 5: AI MODEL OPTIMIZATION ====================

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama                # Options: tinyllama (4GB), phi (3GB), neural-chat (8GB+)
OLLAMA_CONTEXT=1024                   # Token context window (reduce to 512 if memory constrained)
OLLAMA_IDLE_UNLOAD_SECONDS=300        # Auto-unload model after 5 min idle

# AI Response Caching
AI_CACHE_TTL_SECONDS=86400            # 24 hour cache for AI responses
# Redis is used for caching. Falls back to in-memory cache if unavailable

# System Resources (4GB RAM laptop)
# Tinyllama: ~300MB when loaded
# Phi: ~200MB when loaded
# Total system: ~400MB target (Python + AI + Cache + Misc)

# ==================== STANDARD CONFIGURATION ====================

GMAIL_PAGE_SIZE=10
GMAIL_SYNC_WINDOW_DAYS=14
CAMPAIGN_SEND_RATE_PER_MINUTE=2
RATE_LIMIT_REQUESTS_PER_MINUTE=60
LOG_LEVEL=INFO
